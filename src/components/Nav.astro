---
const links = [
	{ label: "Services", href: "#services" },
	{ label: "Approach", href: "#approach" },
	{ label: "Security", href: "#security" },
	{ label: "Contact", href: "#contact" },
];
---

<header class="nav" id="top">
	<div class="container nav-inner">
		<a href="#top" class="nav-logo" aria-label="Keystone — home">
			<span class="nav-mark"></span>
			<span class="nav-name">Keystone</span>
		</a>
		<nav class="nav-links" aria-label="Primary">
			{
				links.map((l) => (
					<a href={l.href}>{l.label}</a>
				))
			}
		</nav>
		<div class="nav-right">
			<a href="#contact" class="btn btn-primary btn-sm nav-cta">Book a call</a>
			<button class="nav-toggle" id="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
	<nav class="nav-mobile" id="nav-menu" aria-label="Mobile">
			{
				links.map((l) => (
					<a href={l.href}>{l.label}</a>
				))
			}
			<a href="#contact" class="btn btn-primary">Book a call</a>
		</nav>
</header>